# Copy to .env and load before k6, or pass with k6 run -e KEY=value
# PowerShell: Get-Content .env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item -Path "env:$($matches[1])" -Value $matches[2].Trim() } }; k6 run botforge-load-test.js

# Target API (no trailing slash)
BASE_URL=http://localhost:8000

# Public widget (from workspace widget settings in dashboard / DB)
PUBLIC_WIDGET_KEY=
# Origin must match widget domain allowlist (often the site embedding the widget)
WIDGET_ORIGIN=http://localhost:3000

# Auth + CRM path (dashboard user; use a dedicated load-test account, never production admin)
LOADTEST_LOGIN_EMAIL=
LOADTEST_LOGIN_PASSWORD=

# Optional: knowledge upload scenario (multipart PDF path on runner machine)
# LOADTEST_BOT_ID=00000000-0000-0000-0000-000000000000
# LOADTEST_PDF_PATH=./fixtures/sample.pdf

# Threshold profile: smoke | standard | stress (see README)
THRESHOLD_PROFILE=smoke
