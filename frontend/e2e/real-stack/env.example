# Copy to .env.local or export before running real-stack E2E (see docs/qa/E2E_REAL_STACK.md).

# Next → FastAPI (Playwright starts Next via playwright.real-stack.config.ts)
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Optional: PDF upload E2E (API must have S3 / object storage configured)
# E2E_WITH_OBJECT_STORAGE=1

# Optional: public widget chat turn (API must have working GEMINI / provider)
# E2E_WIDGET_CHAT=1

# Optional: Telegram token validate only (never stored by this test)
# E2E_TELEGRAM_BOT_TOKEN=123456:AA...

# Optional: custom seed JSON path for seeded-workspace.spec.ts
# E2E_SEED_OUTPUT_PATH=/abs/path/to/seed-output.json

# Optional: do not start Next from Playwright (you already have it running)
# E2E_SKIP_WEBSERVER=1
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3002
