# Phoenix AI — frontend environment (copy to .env.local and fill in)

# ---------------------------------------------------------------------------
# Gemini (advisor chat explanations)
#
# The deterministic engine computes every figure in the browser; Gemini only
# phrases a short explanation of those numbers. Without a key the chat keeps
# working in rule-based mode — nothing breaks.
#
# Key: https://aistudio.google.com/apikey  (server-side only, never NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---------------------------------------------------------------------------
# Demo login (jury access without the Python backend)
#
# In dev builds demo@phoenix.uz / Phoenix2026! works out of the box.
# For a production build set this to 1 to keep the demo pair active.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_LOGIN=1

# Python backend origin for proxied API calls (only needed when it runs)
# BACKEND_INTERNAL_URL=http://127.0.0.1:8010
