# FastAPI base (no trailing slash).
# Leave empty to call same-origin /api/* — next.config.ts rewrites to the backend in dev (default http://127.0.0.1:8000).
# Or set e.g. http://localhost:8000 for direct browser calls (then enable CORS on the API for this origin).
NEXT_PUBLIC_API_BASE_URL=

# Optional: full URL to hosted botforge-widget.js so the dashboard embed snippet is copy-paste exact.
# NEXT_PUBLIC_WIDGET_SCRIPT_URL=https://cdn.example.com/botforge-widget.js

# If you use direct calls to :8000, backend must allow this origin in CORS (APP_CORS_ORIGINS).
# For Google/GitHub OAuth, set backend APP_FRONTEND_OAUTH_REDIRECT_URL to this app’s callback, e.g.:
#   http://localhost:3000/auth/callback

# Secure session: match API APP_AUTH_COOKIE_ENABLED + APP_CORS_ALLOW_CREDENTIALS; uses credentials + CSRF headers.
# NEXT_PUBLIC_AUTH_COOKIE_MODE=true
# Optional override if backend uses a custom header (default X-CSRF-Token)
# NEXT_PUBLIC_AUTH_CSRF_HEADER_NAME=X-CSRF-Token
