# Copy to ".env" in the project root (Compose loads it for variable substitution and the backend container).
# Use Docker Compose service names as hostnames (postgres, redis, minio), not localhost, for traffic between containers.
#
# APP_ENVIRONMENT values (see docs/deployment/ENVIRONMENTS.md):
#   local      — developer machine, uvicorn, optional .env
#   docker     — this file + docker-compose (not strict; same relaxed rules as local)
#   staging    — pre-production (same strict checks as production: DATABASE_URL, JWT ≥32, no reload, etc.)
#   production — live (strict checks)

# --- Application (pydantic-settings: env prefix APP_) ---
APP_ENVIRONMENT=docker
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false
# Duplicate line-based access log (default: structured middleware only)
APP_USE_UVICORN_ACCESS_LOG=false
# Never enable in staging/production (enforced when APP_ENVIRONMENT is staging or production)
APP_LOG_REQUEST_BODY=false
# Never enable in staging/production; adds exception type to JSON (no stack traces)
APP_EXPOSE_ERROR_DETAILS=false
APP_EXPOSE_DOCS=true

# JWT signing (use JWT_SECRET_KEY or APP_JWT_SECRET_KEY). Required for staging/production; min 32 characters.
# Also required for Google/GitHub OAuth /start (OAuth ``state`` is signed with this secret).
JWT_SECRET_KEY=replace_with_long_random_string_at_least_32_chars
#
# --- Google OAuth (optional; required for /api/v1/auth/google/*) ---
# Backend callback URL must match Google Cloud Console "Authorized redirect URIs", e.g.:
APP_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# SPA page that receives oauth_exchange_code or oauth_error query params, e.g.:
APP_FRONTEND_OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- GitHub OAuth (optional; /api/v1/auth/github/*) ---
APP_GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...
APP_JWT_ALGORITHM=HS256
APP_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
APP_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS: comma-separated origins (localhost and 127.0.0.1 are different in browsers)
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Cookie auth: requires explicit origins (no *) and APP_CORS_ALLOW_CREDENTIALS=true
# APP_CORS_ALLOW_CREDENTIALS=true
# APP_AUTH_COOKIE_ENABLED=false
# Omit JWTs from JSON bodies (tokens only in HttpOnly cookies); frontend NEXT_PUBLIC_AUTH_COOKIE_MODE=true
# APP_AUTH_COOKIE_OMIT_BODY_TOKENS=false
# APP_AUTH_COOKIE_SECURE=           # unset = true in staging/production
# APP_AUTH_COOKIE_SAMESITE=lax      # lax | strict | none (none needs HTTPS + Secure)
# APP_AUTH_COOKIE_DOMAIN=           # optional e.g. .example.com
# APP_AUTH_COOKIE_PATH=/
# APP_AUTH_ACCESS_COOKIE_NAME=bf_access
# APP_AUTH_REFRESH_COOKIE_NAME=bf_refresh
# APP_AUTH_CSRF_COOKIE_NAME=bf_csrf
# APP_AUTH_CSRF_HEADER_NAME=X-CSRF-Token

# Host port published for the API (maps to APP_PORT inside the container)
APP_PUBLISH_PORT=8000

# --- PostgreSQL (Compose service: postgres) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=app
POSTGRES_PUBLISH_PORT=5432

# Async SQLAlchemy / Alembic — DB user/password MUST match POSTGRES_USER / POSTGRES_PASSWORD (same DB name)
DATABASE_URL=postgresql+asyncpg://app:change_me_postgres@postgres:5432/app

# --- Telegram bot channel (optional; /api/v1/bots/{id}/telegram/connect) ---
# Dedicated Fernet key for bot token + webhook secret_token at rest (NOT derived from JWT_SECRET_KEY).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required for POST /api/v1/bots/{id}/telegram/connect (encrypts token + webhook secret). Needed in local/docker too.
# Staging/production also require this key at process startup.
# APP_TELEGRAM_TOKEN_FERNET_KEY=
# Public origin of this API as seen by Telegram (no path). Required to build webhook URL for setWebhook.
# Local (non-production): http://localhost:8000 or http://127.0.0.1:8000 is allowed. Production: HTTPS only.
# After changing this URL (e.g. new ngrok host), call POST /api/v1/bots/telegram/webhooks/resync-all (authenticated).
# APP_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Redis (Compose service: redis) ---
REDIS_PUBLISH_PORT=6379
REDIS_URL=redis://redis:6379/0
# Same URL is used for distributed rate limits + public widget abuse when set (aliases: RATE_LIMIT_REDIS_URL, APP_RATE_LIMIT_REDIS_URL).
# Optional: APP_RATE_LIMIT_REDIS_KEY_PREFIX=bf:rl
# APP_RATE_LIMIT_AUTH_FAIL_CLOSED_ON_REDIS_ERROR=true
# APP_RATE_LIMIT_PUBLIC_FAIL_OPEN_ON_REDIS_ERROR=true

# --- MinIO (Compose service: minio; S3-compatible API on port 9000) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_secret_16p
MINIO_API_PUBLISH_PORT=9000
MINIO_CONSOLE_PUBLISH_PORT=9001
# In-container and service-to-service base URL (no localhost)
MINIO_ENDPOINT=http://minio:9000
# Optional: convenience for SDKs that expect AWS-style variables
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change_me_minio_secret_16p
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
# Knowledge PDF storage (set bucket for uploads; can match a MinIO bucket you create)
# S3_BUCKET=botforge-knowledge

# --- Ollama (local LLM, cost-free alternative to Gemini) ---
# Default provider is now "ollama". Runs as Docker sidecar, no API key needed.
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_DEFAULT_MODEL=qwen2.5:7b
# OLLAMA_PUBLISH_PORT=11434
# OLLAMA_REQUEST_TIMEOUT_SECONDS=120
# OLLAMA_CONNECT_TIMEOUT_SECONDS=10

# --- Gemini (cloud LLM, optional fallback) ---
# GEMINI_API_KEY=
# APP_GEMINI_DEFAULT_MODEL=gemini-2.5-flash
# Gemini 2.5+ only: 0 disables internal “thinking” tokens (lower usage on simple chats). Set false to omit the field.
# APP_GEMINI_SEND_THINKING_CONFIG=true
# APP_GEMINI_THINKING_BUDGET=0
# MVP AI guardrails (optional overrides; see Settings defaults)
# APP_AI_MAX_OUTPUT_TOKENS_CEILING=8192
# APP_AI_MAX_OUTPUT_TOKENS_DEFAULT=2048
# Semantic cache (Redis + embedContent on API v1): repeat short questions skip chat completion tokens.
# EMBEDDING_MODEL=models/text-embedding-004
# APP_AI_SEMANTIC_CACHE_ENABLED=true
# APP_AI_SEMANTIC_CACHE_REDIS_URL=redis://redis:6379/2
# APP_AI_SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
# Embedding failure policy: false (default) skips cache and lets LLM proceed; true blocks on error (strict/test mode only).
# APP_AI_SEMANTIC_CACHE_STRICT_EMBEDDING=false
# Exact-match completion cache (Redis GET) runs before embedding; can be on without semantic cache.
# APP_AI_EXACT_CACHE_ENABLED=true
# APP_AI_EXACT_CACHE_TTL_SECONDS=172800
# APP_AI_EXACT_CACHE_MAX_MESSAGE_CHARS=2048
# Structured logs: trivial/cache/LLM boundaries (set true only while diagnosing).
# APP_AI_PIPELINE_DEBUG_TRACE_ENABLED=false
# Sales: Gemini intent only on ambiguous text when rules miss (with APP_AI_SALES_USE_MODEL_FOR_INTENT_WHEN_RULES_MISS=true).
# APP_AI_SALES_INTENT_GEMINI_AMBIGUITY_ONLY=true
# Sales: per-bot LLM burst protection (Redis) for opening-style messages (window + max calls).
# APP_AI_SALES_LLM_BURST_PROTECTION_ENABLED=true
# APP_AI_SALES_LLM_BURST_WINDOW_SECONDS=30
# APP_AI_SALES_LLM_BURST_MAX_CALLS_PER_WINDOW=8
# User-facing line when Gemini chat is rate-limited (Uzbek default).
# APP_AI_TELEGRAM_GEMINI_RATE_LIMIT_USER_MESSAGE_UZ=Hozir yuklama biroz yuqori. Iltimos, savolingizni 1 daqiqadan keyin qayta yuboring.
# Char budget for tokens_saved_est on cache/trivial paths (observability only).
# APP_AI_PIPELINE_SAVED_TOKENS_SYSTEM_CHARS=3600
# Short-message prompt slimming (smaller system + fewer history turns)
# APP_AI_PROMPT_SLIM_FOR_SHORT_MESSAGES=true
# APP_AI_PROMPT_SLIM_WORD_THRESHOLD=3
# APP_AI_PROMPT_SLIM_HISTORY_CAP=4
# Per-bot UTC daily cap on sum(tokens_total) in ai_usage_logs (0 = off for local only).
# APP_AI_DAILY_TOTAL_TOKENS_SOFT_CAP_PER_BOT=0
# Per-owner UTC calendar month cap across all bots (0 = off locally). Required >0 in staging/production.
# APP_AI_MONTHLY_TOTAL_TOKENS_CAP_PER_OWNER=0
# Log when usage >= this fraction of cap (0.5–1.0).
# APP_AI_USAGE_QUOTA_WARN_FRACTION=0.9
# --- Security hardening ---
# HSTS (enable only behind HTTPS everywhere)
# APP_SECURITY_ENABLE_HSTS=false
# APP_SECURITY_HSTS_MAX_AGE=31536000
# APP_SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
# APP_SECURITY_HSTS_PRELOAD=false
# CSP extensions (space-separated extra origins)
# APP_SECURITY_CSP_EXTRA_CONNECT_SRC=https://sentry.io
# APP_SECURITY_CSP_EXTRA_SCRIPT_SRC=
# Request timeouts (seconds)
# APP_SECURITY_REQUEST_TIMEOUT_SECONDS=60
# APP_SECURITY_UPLOAD_TIMEOUT_SECONDS=300

# --- Error tracking (optional) ---
# SENTRY_DSN=
# SENTRY_RELEASE=1.0.0+gitsha

# See docs/deployment/PRODUCTION_ENV.md for the full staging/production variable matrix.
